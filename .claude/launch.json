{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "client",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "client-prod",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd client && npx vite build && npx vite preview --port 4173 --strictPort"
      ],
      "port": 4173
    }
  ]
}