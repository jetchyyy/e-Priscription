# Supabase project (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Public URL of this app (used to build the shareable /rx/:id link).
# Leave empty to use the current browser origin.
VITE_APP_URL=

# "mock" = test gateway (QR opens /mock-pay/:reference). Switch to "live" with a real gateway.
VITE_PAYMENT_MODE=mock

# Default prescription access fee shown to doctors (PHP)
VITE_DEFAULT_RX_FEE=50
