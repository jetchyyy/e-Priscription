# Supabase project (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Public URL of this app, with no trailing slash. Used for shareable /rx/:id links, the link-preview (Open Graph)
# tags, robots.txt and sitemap.xml. Example: https://e-prescription.odysseyph.com
VITE_APP_URL=

# Default prescription access fee shown to doctors (PHP)
VITE_DEFAULT_RX_FEE=50
