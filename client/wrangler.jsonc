// Used only when the Cloudflare dashboard's "Root directory" is set to client. Same Worker as ../wrangler.jsonc:
// the static build plus the server code under /api/*. See ../wrangler.jsonc for the secrets it needs.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "e-prescription",
  "main": "../worker/src/index.ts",
  "compatibility_date": "2025-10-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
