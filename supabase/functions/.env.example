# Secrets for Supabase Edge Functions. Never put these in client/.env or give them a VITE_ name:
# anything VITE_ is shipped to every browser.
#
# Local:  supabase functions serve --env-file supabase/functions/.env
# Live:   supabase secrets set --env-file supabase/functions/.env

# PayMongo dashboard -> Developers -> API Keys. Use the test keys (sk_test_/pk_test_) until live testing is done.
PAYMONGO_SECRET_KEY=sk_test_
PAYMONGO_PUBLIC_KEY=pk_test_

# PayMongo dashboard -> Developers -> Webhooks. Created when the webhook endpoint is registered (starts with whsk_).
PAYMONGO_WEBHOOK_SECRET=whsk_

# Public site address, used for the return links after checkout (no trailing slash).
APP_URL=https://e-prescription.odysseyph.com

# Optional. The PayMongo Wallet account payouts are sent from. Leave empty to look it up automatically.
PAYMONGO_SOURCE_ACCOUNT_NUMBER=
PAYMONGO_SOURCE_ACCOUNT_NAME=
PAYMONGO_SOURCE_ACCOUNT_BIC=
