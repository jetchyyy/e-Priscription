// Cloudflare Workers config, built from the repository root (the Cloudflare dashboard default).
// One Worker does two jobs:
//   * serves the Vite build (client/dist) as static files, and
//   * runs the server code in worker/src under /api/* (sign-up, embedded PayMongo payments, payouts and refunds, webhook).
// Only /api/* runs the Worker code; every other request is answered from the static files directly.
//
// Settings and secrets (none of them go in this file). Set each once with `npx wrangler secret put <NAME>`,
// or in the dashboard under Settings -> Variables and Secrets as type "Secret" so a deploy never removes them:
//   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
//   PAYMONGO_SECRET_KEY, PAYMONGO_PUBLIC_KEY, PAYMONGO_WEBHOOK_SECRET,
//   optional: APP_URL, PAYMONGO_SOURCE_ACCOUNT_NUMBER, PAYMONGO_SOURCE_ACCOUNT_NAME, PAYMONGO_SOURCE_ACCOUNT_BIC
// For local development copy .dev.vars.example to .dev.vars (git ignores it).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "e-prescription",
  "main": "./worker/src/index.ts",
  "compatibility_date": "2025-10-01",
  "observability": { "enabled": true },
  // Every 15 minutes: digital tax from PayMongo's payouts, and the Saturday doctor payouts (worker/src/cron.ts).
  "triggers": { "crons": ["*/15 * * * *"] },
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    // Deep links such as /rx/<id> or /doctor/plan load index.html and React Router takes over.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
